<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!--
        beans.xml - Spring XML配置文件示例
        用于演示如何使用XML方式配置Spring容器中的Bean

        本配置文件展示了：
        1. 基本Bean定义（使用classpath）
        2. Bean属性注入
        3. Bean作用域配置
        4. 静态工厂方法创建Bean
        5. 实例工厂方法创建Bean
    -->

    <!-- ==================== 基础Bean定义 ==================== -->

    <!--
        id: Bean的唯一标识符，通过此id可以从容器中获取Bean
        class: Bean的全限定类名，Spring会使用反射调用无参构造器创建实例
        scope: Bean的作用域，可选值包括：
            - singleton: 单例模式，整个容器中只有一个实例（默认）
            - prototype: 原型模式，每次获取都会创建新实例
            - request: 请求作用域（仅Web应用有效）
            - session: 会话作用域（仅Web应用有效）
    -->
    <bean id="xmlConfigBean" class="com.example.model.Config" scope="singleton">
        <!--
            property标签：用于注入Bean的属性值
            name: 属性名称（必须与类中的setter方法对应，如setMessage对应name="message"）
            value: 简单类型的属性值，Spring会自动进行类型转换
        -->
        <property name="message" value="这是通过XML配置加载的Bean"/>
        <property name="active" value="true"/>
    </bean>

    <!--
        演示构造函数注入：
        constructor-arg标签用于指定构造函数参数
        index: 参数索引位置（从0开始）
        type: 参数类型（可选，用于区分重载构造函数）
        value: 参数值
    -->
    <bean id="configWithConstructor" class="com.example.model.Config">
        <constructor-arg index="0" value="构造函数注入的消息"/>
        <constructor-arg index="1" value="true"/>
    </bean>

    <!-- ==================== Bean作用域示例 ==================== -->

    <!--
        prototype作用域：每次从容器获取都会创建新的实例
        适用于有状态的Bean，因为每次使用都应该有独立的实例
    -->
    <bean id="prototypeBean" class="com.example.model.Config" scope="prototype">
        <property name="message" value="prototype作用域示例"/>
    </bean>

    <!--
        singleton作用域（默认）：整个容器中只有一个实例
        适用于无状态的Bean，共享同一个实例可以节省资源
    -->
    <bean id="singletonBean" class="com.example.model.Config" scope="singleton">
        <property name="message" value="singleton作用域示例"/>
    </bean>

    <!-- ==================== 延迟初始化 ==================== -->

    <!--
        lazy-init: 设置Bean是否延迟初始化
        - default: 跟随<beans>标签的default-lazy-init设置
        - true: 延迟初始化，第一次使用时才创建实例
        - false: 立即初始化，容器启动时就创建实例（默认）
        延迟初始化可以加快容器启动速度，但会增加第一次访问时的延迟
    -->
    <bean id="lazyInitBean" class="com.example.model.Config" lazy-init="true">
        <property name="message" value="延迟初始化的Bean"/>
    </bean>

    <!-- ==================== 初始化和销毁回调 ==================== -->

    <!--
        init-method: 指定初始化方法，在Bean实例创建后立即调用
        destroy-method: 指定销毁方法，在Bean即将被销毁前调用
        注意：destroy-method仅在singleton作用域的Bean销毁时生效
    -->
    <bean id="lifecycleBean" class="com.example.model.Config"
          init-method="init"
          destroy-method="cleanup">
        <property name="message" value="带有生命周期回调的Bean"/>
    </bean>

    <!-- ==================== 依赖注入（DI） ==================== -->

    <!--
        构造器注入的第二种方式：使用index和type区分重载构造函数
        下面的例子展示如何区分String和int类型的构造函数参数
    -->
    <bean id="constructorByType" class="com.example.model.Config">
        <constructor-arg type="java.lang.String" value="通过类型区分的参数"/>
        <constructor-arg type="boolean" value="true"/>
    </bean>

</beans>
