<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目groupId，通常使用公司或组织的反向域名 -->
    <groupId>com.example</groupId>

    <!-- 项目artifactId，用于构建时的文件名 -->
    <artifactId>demo004-SpringContext</artifactId>

    <!-- 项目版本号 -->
    <version>1.0-SNAPSHOT</version>

    <!-- 打包方式，Java项目通常使用jar -->
    <packaging>jar</packaging>

    <!-- 项目名称 -->
    <name>Spring Context Demo</name>

    <!-- 项目描述 -->
    <description>Spring Context（应用上下文）深入学习示例</description>

    <!-- Spring Context 依赖 -->
    <!-- spring-context是Spring框架的核心模块之一，提供了IoC容器和依赖注入功能 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.1.0</version>
        </dependency>

        <!-- Spring Core依赖，spring-context的传递依赖 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>6.1.0</version>
        </dependency>

        <!-- Spring Beans依赖，提供了BeanFactory和BeanDefinition等核心类 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>6.1.0</version>
        </dependency>

        <!-- Spring Expression Language (SpEL) 依赖，用于表达式求值 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <version>6.1.0</version>
        </dependency>

        <!-- JCL日志门面，确保Spring框架能正常输出日志 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- JUnit 5 测试框架，用于编写和运行单元测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Maven构建配置 -->
    <build>
        <!-- 插件列表 -->
        <plugins>
            <!-- Maven编译插件，指定Java版本为17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 源代码Java版本 -->
                    <source>17</source>
                    <!-- 目标Java版本 -->
                    <target>17</target>
                    <!-- 字符编码 -->
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven运行插件，用于直接运行main类 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- 指定主类 -->
                    <mainClass>com.example.MainApp</mainClass>
                </configuration>
            </plugin>

            <!-- Maven Surefire插件，用于运行测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>
</project>
