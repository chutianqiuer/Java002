<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/aop
           http://www.springframework.org/schema/aop/spring-aop.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!--
        Spring AOP XML配置示例

        本配置文件演示如何使用XML方式配置Spring AOP
        在实际项目中，可以选择：
        1. XML配置方式（本案）：配置集中，但繁琐
        2. @AspectJ注解方式（推荐）：配置简单，代码清晰

        Spring AOP核心概念对应XML配置：
        - aspect：切面 = 切入点 + 通知
        - pointcut：切入点表达式
        - advice：通知（before、after、after-returning、after-throwing、around）
        - weaving：织入（Spring AOP自动完成）
    -->

    <!-- 启用@AspectJ注解支持 -->
    <!-- 启用后，Spring会自动扫描@Aspect注解的类并创建代理 -->
    <aop:aspectj-autoproxy/>

    <!--
        配置说明：
        - aspectj-autoproxy：启用AspectJ自动代理
        - proxy-target-class：
          true = 强制使用CGLIB代理
          false = 使用JDK动态代理（如果目标类实现了接口）
        - expose-proxy：是否将代理暴露到ThreadLocal中
    -->

    <!-- ========== 定义切面（Aspect） ========== -->

    <!--
        日志切面 - 通过XML配置实现@Before、@After、@AfterReturning效果
        对应注解版本：LoggingAspect.java
    -->
    <bean id="loggingAspect" class="com.example.aop.aspect.LoggingAspect"/>
    <!--
        性能监控切面 - 通过XML配置实现@Around效果
        对应注解版本：PerformanceAspect.java
    -->
    <bean id="performanceAspect" class="com.example.aop.aspect.PerformanceAspect"/>
    <!--
        验证切面 - 通过XML配置实现@AfterThrowing效果
        对应注解版本：ValidationAspect.java
    -->
    <bean id="validationAspect" class="com.example.aop.aspect.ValidationAspect"/>

    <!-- ========== 配置AOP切面 ========== -->
    <aop:config>

        <!--
            定义切入点（Pointcut）
            expression：切入点表达式
            id：切入点的唯一标识符
        -->
        <aop:pointcut id="userServicePointcut"
            expression="within(com.example.aop.service.UserService)"/>

        <aop:pointcut id="orderServicePointcut"
            expression="within(com.example.aop.service.OrderService)"/>

        <aop:pointcut id="allServicePointcut"
            expression="within(com.example.aop.service.*)"/>

        <aop:pointcut id="loggingPointcut"
            expression="execution(* com.example.aop.service.UserService.find*(..)) ||
                       execution(* com.example.aop.service.UserService.save*(..)) ||
                       execution(* com.example.aop.service.UserService.delete*(..)) ||
                       execution(* com.example.aop.service.UserService.update*(..))"/>

        <aop:pointcut id="performancePointcut"
            expression="execution(* com.example.aop.service.UserService.*(..)) ||
                       execution(* com.example.aop.service.OrderService.*(..))"/>

        <!--
            定义切面（Aspect）
            ref：引用上面定义的bean（切面类）
        -->
        <aop:aspect id="loggingAspectConfig" ref="loggingAspect">
            <!--
                前置通知（@Before）
                pointcut-ref：引用定义的切入点
                method：切面类中通知方法名
            -->
            <aop:before pointcut-ref="loggingPointcut" method="beforeAdvice"/>

            <!--
                后置通知（@After）
                无论是否异常都会执行
            -->
            <aop:after pointcut-ref="loggingPointcut" method="afterAdvice"/>

            <!--
                返回通知（@AfterReturning）
                returning：指定返回值参数名
            -->
            <aop:after-returning pointcut-ref="loggingPointcut"
                                 method="afterReturningAdvice"
                                 returning="result"/>
        </aop:aspect>

        <!-- 性能监控切面 -->
        <aop:aspect id="performanceAspectConfig" ref="performanceAspect">
            <!--
                环绕通知（@Around）
                这是最强大的通知类型
            -->
            <aop:around pointcut-ref="performancePointcut" method="monitorPerformance"/>

            <!-- 查询方法性能监控 -->
            <aop:around pointcut-ref="queryMethodPointcut" method="monitorQueryPerformance"/>
        </aop:aspect>

        <!-- 异常处理切面 -->
        <aop:aspect id="validationAspectConfig" ref="validationAspect">
            <!--
                异常通知（@AfterThrowing）
                throwing：指定异常参数名
            -->
            <aop:after-throwing pointcut-ref="allServicePointcut"
                                method="handleException"
                                throwing="exception"/>
        </aop:aspect>
    </aop:config>

    <!-- ========== 定义业务Bean ========== -->

    <!--
        UserService Bean配置
        注意：不需要手动配置代理，Spring AOP会自动为其创建代理
        因为已经启用了aspectj-autoproxy
    -->
    <bean id="userService" class="com.example.aop.service.UserService"/>

    <!-- OrderService Bean配置 -->
    <bean id="orderService" class="com.example.aop.service.OrderService"/>

</beans>
